#!/usr/bin/env bash
# UserPromptSubmit / UserPromptExpansion hook — fetches relevant memories from
# agent-mem and injects them as context before Claude processes the prompt.
# Outputs well-formed hookSpecificOutput JSON so Claude Code uses the proper
# additionalContext injection path (not the legacy plain-text path).
# Exits 0 on any error (silent fail) so it never blocks the prompt.

command -v jq >/dev/null 2>&1 || exit 0
command -v curl >/dev/null 2>&1 || exit 0

_agentmem_done() {
    printf '{}\n'
    exit 0
}

_agentmem_debug() {
    [ "${AGENTMEMORY_HOOK_DEBUG:-}" = "1" ] && printf '[agentmem-recall] %s\n' "$*" >&2
}

INPUT=$(cat)
printf '%s' "$INPUT" | jq empty 2>/dev/null || _agentmem_done

# Works for both UserPromptSubmit (.prompt) and UserPromptExpansion (.expansion).
QUERY=$(printf '%s' "$INPUT" | jq -r '(.prompt // .expansion // "") | .[0:300]')
[ -z "$QUERY" ] && _agentmem_done

_agentmem_significant_token_count() {
    printf '%s' "$1" | awk '
    BEGIN {
      stop["a"]; stop["an"]; stop["and"]; stop["are"]; stop["can"]; stop["check"]; stop["did"]; stop["do"]; stop["does"];
      stop["for"]; stop["hello"]; stop["hey"]; stop["hi"]; stop["in"]; stop["is"]; stop["it"]; stop["me"];
      stop["no"]; stop["now"]; stop["of"]; stop["ok"]; stop["okay"]; stop["on"]; stop["or"]; stop["please"];
      stop["that"]; stop["the"]; stop["this"]; stop["to"]; stop["was"]; stop["were"]; stop["with"]; stop["yes"]; stop["you"];
    }
    {
      lower=tolower($0);
      n=split(lower, parts, /[^[:alnum:]_]+/);
      count=0;
      for (i=1; i<=n; i++) {
        tok=parts[i];
        if (length(tok) >= 2 && !(tok in stop)) count++;
      }
      print count;
    }'
}

SIGNIFICANT_TOKENS=$(_agentmem_significant_token_count "$QUERY")
if [ "${SIGNIFICANT_TOKENS:-0}" -lt 2 ]; then
    _agentmem_debug "query has $SIGNIFICANT_TOKENS significant tokens; skipping"
    _agentmem_done
fi

EVENT=$(printf '%s' "$INPUT" | jq -r '.hook_event_name // "UserPromptSubmit"')

_agentmem_debug "query ($EVENT): $QUERY"

CWD="$(pwd)"

_agentmem_env_file() {
    if [ -n "${AGENTMEMORY_ENV_FILE:-}" ] && [ -f "$AGENTMEMORY_ENV_FILE" ]; then
        printf '%s' "$AGENTMEMORY_ENV_FILE"; return
    fi
    local d="$CWD"
    while [ "$d" != "/" ]; do
        [ -f "$d/.env.mcp" ] && { printf '%s' "$d/.env.mcp"; return; }
        d=$(dirname "$d")
    done
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/agent-mem/.env.mcp"
    [ -f "$cfg" ] && printf '%s' "$cfg"
}

if [ -z "${AGENTMEMORY_URL:-}" ] || [ -z "${AGENTMEMORY_SECRET:-}" ] || [ -z "${AGENTMEMORY_PROJECT:-}" ]; then
    _ENV=$(_agentmem_env_file)
    if [ -n "$_ENV" ]; then
        [ -z "${AGENTMEMORY_URL:-}" ]     && AGENTMEMORY_URL=$(grep     '^AGENTMEMORY_URL='     "$_ENV" 2>/dev/null | cut -d= -f2-)
        [ -z "${AGENTMEMORY_SECRET:-}" ]  && AGENTMEMORY_SECRET=$(grep  '^AGENTMEMORY_SECRET='  "$_ENV" 2>/dev/null | cut -d= -f2-)
        [ -z "${AGENTMEMORY_PROJECT:-}" ] && AGENTMEMORY_PROJECT=$(grep '^AGENTMEMORY_PROJECT=' "$_ENV" 2>/dev/null | cut -d= -f2-)
    fi
fi
AGENTMEMORY_URL="${AGENTMEMORY_URL:-http://localhost:3111}"

if [ -n "${AGENTMEMORY_PROJECT:-}" ]; then
    PROJECT="$AGENTMEMORY_PROJECT"
else
    _REMOTE=$(git -C "$CWD" remote get-url origin 2>/dev/null || true)
    _BRANCH=$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [ -n "$_REMOTE" ] && [ -n "$_BRANCH" ]; then
        PROJECT="${_REMOTE}__${_BRANCH}"
    else
        PROJECT=$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null | xargs basename 2>/dev/null || basename "$CWD")
        PROJECT="${PROJECT}${_BRANCH:+__$_BRANCH}"
    fi
fi

BODY=$(jq -cn --arg q "$QUERY" --arg p "$PROJECT" '{"query": $q, "project": $p, "limit": 5}')

CURL_ARGS=(-s --max-time 20
  -X POST "$AGENTMEMORY_URL/v1/agentmemory/recall-summary"
  -H "Content-Type: application/json")
[ -n "${AGENTMEMORY_SECRET:-}" ] && CURL_ARGS+=(-H "Authorization: Bearer $AGENTMEMORY_SECRET")
CURL_ARGS+=(-d "$BODY")

RESPONSE=$(curl "${CURL_ARGS[@]}" 2>/dev/null) || _agentmem_done

# Require at least one result with enough RRF relevance to avoid injecting noise.
MAX_RELEVANCE=$(printf '%s' "$RESPONSE" | jq -r '[.results[]?.relevance // 0] | max // 0' 2>/dev/null)
PASSES_THRESHOLD=$(printf '%s' "$MAX_RELEVANCE" | awk '{print ($1 >= 0.01) ? "yes" : "no"}')
if [ "$PASSES_THRESHOLD" != "yes" ]; then
    _agentmem_debug "max relevance $MAX_RELEVANCE below threshold; skipping"
    _agentmem_done
fi

SUMMARY=$(printf '%s' "$RESPONSE" | jq -r '.summary // empty' 2>/dev/null)
[ -z "$SUMMARY" ] && _agentmem_done

_agentmem_debug "injecting context ($(printf '%s' "$RESPONSE" | jq '.results | length' 2>/dev/null) results, max relevance $MAX_RELEVANCE)"

CTX="[agent-mem] Relevant context from memory:
$SUMMARY"

jq -cn --arg event "$EVENT" --arg ctx "$CTX" \
  '{"hookSpecificOutput": {"hookEventName": $event, "additionalContext": $ctx}}'
