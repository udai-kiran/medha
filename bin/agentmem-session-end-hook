#!/usr/bin/env bash
# Stop hook — records session_end to agent-mem, triggering consolidation
# (summarisation + memory distillation pipeline).
# Runs synchronously so the session is fully closed before the harness exits.
#
# Install (Claude Code):
#   In .claude/settings.json → hooks → Stop, set command to the path of this
#   script (or symlink it into .claude/hooks/).
#
# Config (in priority order):
#   1. AGENTMEMORY_URL / AGENTMEMORY_SECRET / AGENTMEMORY_PROJECT env vars
#   2. AGENTMEMORY_ENV_FILE env var pointing to a .env.mcp file
#   3. .env.mcp found by walking up from the current working directory
#   4. $XDG_CONFIG_HOME/agent-mem/.env.mcp  (~/.config/agent-mem/.env.mcp)
#   5. Default URL: http://localhost:3111

command -v jq   >/dev/null 2>&1 || exit 0
command -v curl >/dev/null 2>&1 || exit 0

INPUT=$(cat)
printf '%s' "$INPUT" | jq empty 2>/dev/null || exit 0
SESSION_ID=$(printf '%s' "$INPUT" | jq -r '.session_id // empty')
[ -z "$SESSION_ID" ] && exit 0

CWD="$(pwd)"

# Locate .env.mcp: explicit var → walk CWD → XDG config dir
_agentmem_env_file() {
    if [ -n "${AGENTMEMORY_ENV_FILE:-}" ] && [ -f "$AGENTMEMORY_ENV_FILE" ]; then
        printf '%s' "$AGENTMEMORY_ENV_FILE"; return
    fi
    local d="$CWD"
    while [ "$d" != "/" ]; do
        [ -f "$d/.env.mcp" ] && { printf '%s' "$d/.env.mcp"; return; }
        d=$(dirname "$d")
    done
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/agent-mem/.env.mcp"
    [ -f "$cfg" ] && printf '%s' "$cfg"
}

if [ -z "${AGENTMEMORY_URL:-}" ] || [ -z "${AGENTMEMORY_SECRET:-}" ] || [ -z "${AGENTMEMORY_PROJECT:-}" ]; then
    _ENV=$(_agentmem_env_file)
    if [ -n "$_ENV" ]; then
        [ -z "${AGENTMEMORY_URL:-}" ]     && AGENTMEMORY_URL=$(grep     '^AGENTMEMORY_URL='     "$_ENV" 2>/dev/null | cut -d= -f2-)
        [ -z "${AGENTMEMORY_SECRET:-}" ]  && AGENTMEMORY_SECRET=$(grep  '^AGENTMEMORY_SECRET='  "$_ENV" 2>/dev/null | cut -d= -f2-)
        [ -z "${AGENTMEMORY_PROJECT:-}" ] && AGENTMEMORY_PROJECT=$(grep '^AGENTMEMORY_PROJECT=' "$_ENV" 2>/dev/null | cut -d= -f2-)
    fi
fi
AGENTMEMORY_URL="${AGENTMEMORY_URL:-http://localhost:3111}"

if [ -n "${AGENTMEMORY_PROJECT:-}" ]; then
    PROJECT="$AGENTMEMORY_PROJECT"
else
    _REMOTE=$(git -C "$CWD" remote get-url origin 2>/dev/null || true)
    _BRANCH=$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [ -n "$_REMOTE" ] && [ -n "$_BRANCH" ]; then
        PROJECT="${_REMOTE}__${_BRANCH}"
    else
        PROJECT=$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null | xargs basename 2>/dev/null || basename "$CWD")
        PROJECT="${PROJECT}${_BRANCH:+__$_BRANCH}"
    fi
fi
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

PAYLOAD=$(jq -cn \
  --arg ts        "$TS"         \
  --arg cwd       "$CWD"        \
  --arg project   "$PROJECT"    \
  --arg sessionId "$SESSION_ID" \
  '{
    hookType: "session_end",
    sessionId: $sessionId,
    project: $project,
    cwd: $cwd,
    timestamp: $ts,
    data: {}
  }')

CURL_ARGS=(-s -o /dev/null --max-time 10
  -X POST "$AGENTMEMORY_URL/v1/agentmemory/observe"
  -H "Content-Type: application/json")
[ -n "${AGENTMEMORY_SECRET:-}" ] && CURL_ARGS+=(-H "Authorization: Bearer $AGENTMEMORY_SECRET")
CURL_ARGS+=(-d "$PAYLOAD")

curl "${CURL_ARGS[@]}"
exit 0
